---
import { en } from '../i18n/en.ts';
import { getCatalog } from '../lib/catalog-data.ts';

const catalog = getCatalog();
const { commit, commitDate } = catalog.buildInfo;
const known = /^[0-9a-f]{7,40}$/.test(commit);
const short = known ? commit.slice(0, 7) : commit;
const date = commitDate.slice(0, 10);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="container">
    <p data-testid="build-info">
      {en.footer.builtFrom}{' '}
      {
        known ? (
          <a href={`https://github.com/${catalog.repo}/commit/${commit}`} rel="noopener noreferrer">
            <code>{short}</code>
          </a>
        ) : (
          <code>{short}</code>
        )
      }{' '}
      (<time datetime={commitDate}>{date}</time>)
    </p>
    <p>
      <a href={`${base}catalog.json`}>{en.footer.catalogJson}</a> ·
      <a href={`${base}llms.txt`}>{en.footer.llmsTxt}</a> ·
      <a href={`https://github.com/${catalog.repo}`} rel="noopener noreferrer">{en.footer.source}</a>
    </p>
  </div>
</footer>
