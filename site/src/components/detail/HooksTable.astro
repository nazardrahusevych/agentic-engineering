---
import type { HookRow } from '../../catalog/types.ts';
import { en } from '../../i18n/en.ts';

interface Props {
  rows: HookRow[];
}

const { rows } = Astro.props;
const t = en.detail;
---

<table class="hooks-table" data-testid="hooks-table">
  <caption class="visually-hidden">{t.hooksCaption}</caption>
  <thead>
    <tr>
      <th scope="col">{t.hooksColumns.event}</th>
      <th scope="col">{t.hooksColumns.matcher}</th>
      <th scope="col">{t.hooksColumns.type}</th>
      <th scope="col">{t.hooksColumns.command}</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <td>{row.event}</td>
          <td>{row.matcher ? <code>{row.matcher}</code> : t.hooksAllMatchers}</td>
          <td>{row.type}</td>
          <td>{row.command ? <code>{row.command}</code> : t.hooksNoCommand}</td>
        </tr>
      ))
    }
  </tbody>
</table>
