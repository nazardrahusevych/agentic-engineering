---
import CopyCommand from '../components/CopyCommand.tsx';
import SearchApp from '../components/search/SearchApp.tsx';
import { en } from '../i18n/en.ts';
import Base from '../layouts/Base.astro';
import { getCatalog } from '../lib/catalog-data.ts';

const catalog = getCatalog();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { marketplace } = catalog;
---

<Base title={en.landing.title(marketplace.name)} description={en.landing.description(marketplace.name)}>
  <h1>{marketplace.name}</h1>
  <p class="lead">{marketplace.description || en.landing.fallbackDescription} {en.landing.lead}</p>
  <div class="add-marketplace" data-testid="add-marketplace">
    <p>{en.landing.addMarketplace}</p>
    <CopyCommand
      client:load
      command={marketplace.addCommand}
      label={en.landing.copy}
      context={en.landing.copyContext}
      showCommand
    />
  </div>
  <SearchApp client:load base={base} repo={catalog.repo} />
</Base>
